# Copy to .env.local (git-ignored) and fill in. These are build-time variables: on Cloudflare,
# set them in the project's build settings.
#
# Publishable key only (sb_publishable_...). The secret key (sb_secret_...) is for local
# seed/import scripts and never goes in client code, GitHub secrets or Cloudflare settings.
# Local values are printed by `npm run db:start`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
